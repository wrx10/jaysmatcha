# ==============================================================================
# Jay’s Matcha - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Push Notifications for Store Owner (Optional)
# ------------------------------------------------------------------------------
# Used by Node.js server (server.ts) to send real Web Push notifications
# to the Store Owner whenever a new order is received.
# Generated using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:abodas20111@gmail.com"

# Public VAPID key accessible to the browser client (same as VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# ------------------------------------------------------------------------------
# 2. Firebase Authentication Custom Domain (Optional)
# ------------------------------------------------------------------------------
# Defaults to "velvety-wave-gghtt.firebaseapp.com" (configured in firebase-applet-config.json).
# Set this only when you link a custom store domain in Firebase Console.
VITE_FIREBASE_AUTH_DOMAIN="velvety-wave-gghtt.firebaseapp.com"


